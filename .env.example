# Stellar / Soroban RPC endpoint (testnet or futurenet)
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Deployed contract address (32-byte hex, no 0x prefix)
CONTRACT_ID=

# Secret key for the hardware gateway admin account
HARDWARE_GATEWAY_KEY=

# Daemon poll interval in seconds (default: 60)
POLL_INTERVAL_SECS=60

# Rust log filter (tracing / env-filter)
RUST_LOG=energy_daemon=info
